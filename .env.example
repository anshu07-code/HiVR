# =============================================================================
# HiVR — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`. NEXT_PUBLIC_* variables are exposed to the browser.
# Everything else is server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (auth, postgres, storage, realtime, pgvector)
# Get these from: Supabase Dashboard > Project Settings > API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://hcmlbktmdrtvyusucrzc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REDACTED_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REDACTED_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=HiVR

# -----------------------------------------------------------------------------
# AI (OpenRouter gateway — single env var to swap models)
# Get an API key at https://openrouter.ai/keys
# Suggested free-tier models: google/gemini-flash-1.5, meta-llama/llama-3.1-8b-instruct:free
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...your-key
AI_MODEL=google/gemini-flash-1.5
AI_EMBEDDING_MODEL=text-embedding-3-small
# Used by OpenRouter to attribute traffic to your app (optional but recommended)
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=HiVR

# -----------------------------------------------------------------------------
# Razorpay Route (marketplace escrow / split payments)
# Test keys at: https://dashboard.razorpay.com/app/keys (toggle "Test Mode")
# Live keys only after KYC + escrow account approval.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_...your-key-id
RAZORPAY_KEY_SECRET=your-key-secret                # SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret        # SERVER ONLY
# When BYPASS_RAZORPAY_PAYOUTS=true the dev-simulator at
# /api/webhooks/razorpay/dev-simulate is enabled so you can drive the full
# payment lifecycle without a real Razorpay account. Set to false (or unset)
# once you have live test keys.
BYPASS_RAZORPAY_PAYOUTS=true
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...your-key-id

# -----------------------------------------------------------------------------
# Identity verification (mocked in Phase 1)
# Real provider TBD — Surepass / Signzy / HyperVerge / DigiLocker
# Leave blank in dev — the code falls back to a mock sandbox response.
# -----------------------------------------------------------------------------
# VERIFICATION_PROVIDER_API_KEY=
# VERIFICATION_PROVIDER_BASE_URL=

# -----------------------------------------------------------------------------
# Custom SMTP (P1 #5) — optional but recommended
# Without these, Supabase uses its built-in email which is rate-limited to
# 4 emails/hour. Plug in Resend (recommended), Brevo, or SendGrid to send
# thousands of free emails/day.
#
# Resend (https://resend.com) — recommended, 3000/month free:
#   1. Sign up at resend.com/signup
#   2. Verify your domain (or use the sandbox domain resend.dev for dev)
#   3. Create an API key
#   4. In Supabase: Authentication → Providers → SMTP Settings → fill in below
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_SENDER_EMAIL=HiVR <noreply@resend.dev>   # sender name <email>
# SMTP_SENDER_NAME=HiVR
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Cron jobs (P1 #4 — auto-release)
# Used by the auto-release cron route. Generate with: openssl rand -hex 32
# Configure in vercel.json (or your scheduler) to hit:
#   GET /api/cron/auto-release
# with header:  Authorization: Bearer ${CRON_SECRET}
# -----------------------------------------------------------------------------
# CRON_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# Admin bootstrap
# Set this to your own email so the seed script marks you as Super Admin.
# -----------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=heyyanshu.07@gmail.com
